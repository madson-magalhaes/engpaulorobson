# WhatsApp
# Use {cupom} como placeholder para o ref_id (identificador único da sessão)
# Exemplo: "Olá! Quero saber mais. Cupom: {cupom}"
# Se não tiver {cupom}, o ref_id será append no final automaticamente
VITE_WHATSAPP_NUMBER=558899XXXXXXX
VITE_WHATSAPP_MESSAGE=Quero saber mais

# Tenant ID (identifica o cliente)
VITE_TENANT_ID=paulo_robson

